# ============================================================
# V4 行政处罚案卷评查系统 - 环境变量配置
# 复制此文件为 .env 并修改实际值
# ============================================================

# ---- 应用配置 ----
IMAGE_TAG=v4.0.0
APP_PORT=8000
SECRET_KEY=请替换为随机生成的安全密钥

# ---- OCR 配置 ----
OCR_ENGINE=local
MAX_PDF_SIZE=50
MAX_PAGES=500

# ---- 日志配置 ----
LOG_LEVEL=INFO

# ---- 数据库配置 ----
DB_PASSWORD=请替换为强密码

# ---- Nginx 配置 ----
NGINX_PORT=80
NGINX_SSL_PORT=443

# ---- Grafana 配置 ----
GRAFANA_USER=admin
GRAFANA_PASSWORD=请替换为强密码
